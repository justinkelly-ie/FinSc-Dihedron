package FinSc-Dihedron
version = 0.3.0
authors = "Justin Kelly"
brief   = "Layer 5 Split Quaternions, 3D Minkowski Lorentz Group PGL2(Q) & Spinors"

depends = base, linear, FinSc-Multiset, FinSc-Metric-Substrate, FinSc-Phase-Unfolding, FinSc-Radix-Ternary
sourcedir = "src"

modules = Dihedron,
          Stage0.DihedronStream,
          Stage1.Basis,
          Stage1.Dihedron,
          Stage1.DihedralRepIso,
          Stage1.Subalgebras,
          Stage1.DiracSpinor,
          Stage1.ProjectiveDihedron,
          Stage1.TernaryDihedron
